# Normalize all text files to LF in the repository and on checkout.
* text=auto eol=lf

# Windows scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.woff binary
*.woff2 binary
