[Desktop Entry]
Type=Service
MimeType=application/pdf;
Actions=pdfCompressBalanced;pdfCompressMaximum;pdfCompressScanned;pdfCompressBilevel;pdfCompressTarget;
X-KDE-Priority=TopLevel
X-KDE-Submenu=PDF Compressor
X-KDE-Submenu[zh_CN]=PDF 压缩

[Desktop Action pdfCompressBalanced]
Name=Compress PDF (app settings)
Name[zh_CN]=压缩 PDF（应用内配置）
Comment=Uses the quick-compress profile from the app's settings page
Comment[zh_CN]=使用应用设置页中的快速压缩配置，不打开窗口
Exec=pdf-compressor-cli quick %F
Icon=pdf-compressor

[Desktop Action pdfCompressMaximum]
Name=Compress PDF (maximum)
Name[zh_CN]=压缩 PDF（最大化）
Comment=Aggressive shrink with smaller images
Comment[zh_CN]=更激进的图像压缩
Exec=pdf-compressor-cli quick --preset maximum %F
Icon=pdf-compressor

[Desktop Action pdfCompressScanned]
Name=Compress scanned PDF (grayscale)
Name[zh_CN]=压缩扫描件（灰度）
Comment=Best for black-and-white scans
Comment[zh_CN]=适合黑白扫描文档
Exec=pdf-compressor-cli quick --grayscale %F
Icon=pdf-compressor

[Desktop Action pdfCompressBilevel]
Name=Compress scanned PDF (black & white G4)
Name[zh_CN]=压缩扫描件（黑白 G4）
Comment=Lossless CCITT Group 4 for text scans
Comment[zh_CN]=无损 CCITT G4，适合文字扫描件
Exec=pdf-compressor-cli quick --bilevel g4 %F
Icon=pdf-compressor

[Desktop Action pdfCompressTarget]
Name=Compress PDF under 5 MB
Name[zh_CN]=压缩 PDF 至 5MB 以内
Comment=Search settings until the output fits the budget
Comment[zh_CN]=自动搜索参数直到满足大小预算
Exec=pdf-compressor-cli quick --target-size 5MB %F
Icon=pdf-compressor
