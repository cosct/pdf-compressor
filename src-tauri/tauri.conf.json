{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PDF Compressor",
  "version": "0.4.0",
  "identifier": "com.cosct.pdfcompressor",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Compressor",
        "width": 1200,
        "height": 860,
        "minWidth": 1200,
        "minHeight": 800,
        "decorations": false,
        "backgroundColor": "#202020",
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0RTY2RDMyRUY3OTUzQzIKUldUQ1UzbnZNbTNtdEZTMmIxZVppOWxFS2pzRGNzZW9Zc0owN0tNZTFHYjFGd3RVQTNUc2cwYTgK",
      "endpoints": [
        "https://github.com/cosct/pdf-compressor/releases/latest/download/latest.json"
      ]
    }
  }
}
